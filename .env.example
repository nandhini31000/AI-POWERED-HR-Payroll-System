# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payroll_ai_system

# Optional full override. Leave commented unless you prefer one URI.
# DATABASE_URL=mysql+pymysql://root:your-mysql-password@localhost:3306/payroll_ai_system

# AI Assistant (choose one provider; used in the AI HR Assistant module)
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

COMPANY_NAME=Acme Technologies Pvt. Ltd.
COMPANY_ADDRESS=123 Business Park, Chennai, India
